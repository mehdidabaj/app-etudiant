@startuml
title Diagramme de classe d'analyse simplifie

skinparam classAttributeIconSize 0
skinparam shadowing false
left to right direction

class "Pages JSP" as JSP <<boundary>>

class EtudiantServlet <<control>> {
  + lister()
  + ajouter()
  + modifier()
  + supprimer()
  + rechercher()
}

class FiliereServlet <<control>> {
  + lister()
  + ajouter()
  + modifier()
  + supprimer()
}

class Etudiant <<entity>> {
  idEtudiant
  nomEtudiant
  prenomEtudiant
  niveau
}

class Filiere <<entity>> {
  idFiliere
  nomFiliere
}

class EtudiantRepository
class FiliereRepository
class "MySQL" as DB <<database>>

JSP --> EtudiantServlet : /etudiants
JSP --> FiliereServlet : /filieres

EtudiantServlet --> EtudiantRepository
EtudiantServlet --> FiliereRepository : charger filieres
FiliereServlet --> FiliereRepository

EtudiantRepository --> Etudiant
FiliereRepository --> Filiere
Etudiant --> Filiere : appartient a

EtudiantRepository --> DB
FiliereRepository --> DB

@enduml
