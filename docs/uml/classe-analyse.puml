@startuml
title Diagramme de classe d'analyse - CRUD Etudiants et Filieres

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
left to right direction

package "Boundary / Pages JSP" {
  class "Navigateur utilisateur" as Browser <<boundary>>
  class "etudiants/list.jsp" as EtudiantListView <<boundary>>
  class "etudiants/form.jsp" as EtudiantFormView <<boundary>>
  class "filieres/list.jsp" as FiliereListView <<boundary>>
  class "filieres/form.jsp" as FiliereFormView <<boundary>>
}

package "Control / Servlets" {
  class EtudiantServlet <<control>> {
    - etudiantRepository : EtudiantRepository
    - filiereRepository : FiliereRepository
    --
    + doGet(request, response)
    + doPost(request, response)
    - listEtudiants(request, response)
    - showAddForm(request, response)
    - showEditForm(request, response)
    - addEtudiant(request, response)
    - updateEtudiant(request, response)
    - deleteEtudiant(request, response)
    + destroy()
  }

  class FiliereServlet <<control>> {
    - filiereRepository : FiliereRepository
    --
    + init()
    + doGet(request, response)
    + doPost(request, response)
    - listFilieres(request, response)
    - showAddForm(request, response)
    - showEditForm(request, response)
    - addFiliere(request, response)
    - updateFiliere(request, response)
    - deleteFiliere(request, response)
    + destroy()
  }
}

package "Entity / Domaine" {
  class Etudiant <<entity>> {
    - idEtudiant : Integer
    - nomEtudiant : String
    - prenomEtudiant : String
    - niveau : String
    - filiere : Filiere
    --
    + getNomComplet() : String
  }

  class Filiere <<entity>> {
    - idFiliere : Integer
    - nomFiliere : String
    - etudiants : List<Etudiant>
  }
}

package "Persistence / JPA" {
  abstract class "Repository<T, ID>" as Repository {
    # emf : EntityManagerFactory
    # entityClass : Class<T>
    --
    # getEntityManager() : EntityManager
    + save(entity : T) : T
    + findById(id : ID) : T
    + findAll() : List<T>
    + update(entity : T) : T
    + delete(id : ID) : void
    + close() : void
  }

  class EtudiantRepository <<repository>>
  class FiliereRepository <<repository>>
  class "EntityManagerFactory\nGestionPU" as EMF
  class "EntityManager" as EM
  class "MySQL\nBase db_etudiants" as DB <<database>>
}

Browser --> EtudiantServlet : CRUD etudiants\n/etudiants/*
Browser --> FiliereServlet : CRUD filieres\n/filieres/*

EtudiantServlet --> EtudiantListView : afficher liste
EtudiantServlet --> EtudiantFormView : formulaire ajout/modification
FiliereServlet --> FiliereListView : afficher liste
FiliereServlet --> FiliereFormView : formulaire ajout/modification

EtudiantServlet --> EtudiantRepository : save, findById,\nfindAll, update, delete
EtudiantServlet --> FiliereRepository : charger filieres\npour ajout/modification
FiliereServlet --> FiliereRepository : save, findById,\nfindAll, update, delete

EtudiantRepository --|> Repository
FiliereRepository --|> Repository

EtudiantRepository ..> Etudiant
EtudiantRepository ..> Filiere
FiliereRepository ..> Filiere

Filiere "1" <-- "0..*" Etudiant : appartient a

Repository --> EMF : cree si besoin
Repository --> EM : ouvre par operation
EM --> DB : transactions CRUD

note right of EtudiantServlet
  Routes CRUD etudiants :
  /etudiants
  /etudiants/add
  /etudiants/edit
  /etudiants/delete
end note

note right of FiliereServlet
  Routes CRUD filieres :
  /filieres
  /filieres/add
  /filieres/edit
  /filieres/delete
end note

@enduml
