@startuml
title Diagramme de cas d'utilisation - Gestion des etudiants
left to right direction
skinparam shadowing false

actor "Utilisateur" as Utilisateur

rectangle "Application Gestion Universite" {
  usecase "Consulter le\ntableau de bord" as UC_Dashboard
  usecase "Gerer les\netudiants" as UC_Etudiants
  usecase "Rechercher un\netudiant" as UC_Recherche
  usecase "Gerer les\nfilieres" as UC_Filieres
}

Utilisateur --> UC_Dashboard
Utilisateur --> UC_Etudiants
Utilisateur --> UC_Recherche
Utilisateur --> UC_Filieres

note bottom of UC_Etudiants
  Ajouter, modifier,
  supprimer et lister.
end note

@enduml
