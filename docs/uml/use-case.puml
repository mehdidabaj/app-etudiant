@startuml
title Cas d'utilisation - CRUD etudiants et CRUD filieres
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #EEF6FF
  BorderColor #1E5AA8
}
skinparam actor {
  BackgroundColor #FFF3D6
  BorderColor #A66A00
}

actor "Utilisateur" as Utilisateur
actor "SGBD MySQL" as MySQL

rectangle "Application Gestion Universite" {
  package "Gestion des etudiants (CRUD)" {
    usecase "Gerer les\netudiants" as UC_GererEtudiants
    usecase "Lister les\netudiants" as UC_ListerEtudiants
    usecase "Ajouter un\netudiant" as UC_AjouterEtudiant
    usecase "Modifier un\netudiant" as UC_ModifierEtudiant
    usecase "Supprimer un\netudiant" as UC_SupprimerEtudiant
    usecase "Choisir une\nfiliere" as UC_ChoisirFiliere
  }

  package "Gestion des filieres (CRUD)" {
    usecase "Gerer les\nfilieres" as UC_GererFilieres
    usecase "Lister les\nfilieres" as UC_ListerFilieres
    usecase "Ajouter une\nfiliere" as UC_AjouterFiliere
    usecase "Modifier une\nfiliere" as UC_ModifierFiliere
    usecase "Supprimer une\nfiliere" as UC_SupprimerFiliere
  }

  package "Persistance" {
    usecase "Lire les\ndonnees" as UC_Lire
    usecase "Enregistrer les\nchangements" as UC_Ecrire
  }
}

Utilisateur --> UC_GererEtudiants
Utilisateur --> UC_GererFilieres

UC_GererEtudiants ..> UC_ListerEtudiants : <<include>>
UC_GererEtudiants ..> UC_AjouterEtudiant : <<extend>>
UC_GererEtudiants ..> UC_ModifierEtudiant : <<extend>>
UC_GererEtudiants ..> UC_SupprimerEtudiant : <<extend>>

UC_AjouterEtudiant ..> UC_ChoisirFiliere : <<include>>
UC_ModifierEtudiant ..> UC_ChoisirFiliere : <<include>>

UC_ListerEtudiants ..> UC_Lire : <<include>>
UC_ChoisirFiliere ..> UC_Lire : <<include>>
UC_AjouterEtudiant ..> UC_Ecrire : <<include>>
UC_ModifierEtudiant ..> UC_Ecrire : <<include>>
UC_SupprimerEtudiant ..> UC_Ecrire : <<include>>

UC_GererFilieres ..> UC_ListerFilieres : <<include>>
UC_GererFilieres ..> UC_AjouterFiliere : <<extend>>
UC_GererFilieres ..> UC_ModifierFiliere : <<extend>>
UC_GererFilieres ..> UC_SupprimerFiliere : <<extend>>

UC_ListerFilieres ..> UC_Lire : <<include>>
UC_AjouterFiliere ..> UC_Ecrire : <<include>>
UC_ModifierFiliere ..> UC_Ecrire : <<include>>
UC_SupprimerFiliere ..> UC_Ecrire : <<include>>

MySQL <-- UC_Lire
MySQL <-- UC_Ecrire

note right of UC_GererEtudiants
  Routes CRUD :
  GET  /etudiants
  GET  /etudiants/add
  POST /etudiants/add
  GET  /etudiants/edit?id=...
  POST /etudiants/edit
  GET  /etudiants/delete?id=...
end note

note right of UC_GererFilieres
  Routes CRUD :
  GET  /filieres
  GET  /filieres/add
  POST /filieres/add
  GET  /filieres/edit?id=...
  POST /filieres/edit
  GET  /filieres/delete?id=...
end note
@enduml
